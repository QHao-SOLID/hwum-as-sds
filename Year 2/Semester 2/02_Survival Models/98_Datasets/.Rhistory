summary(mean.a)
# Transform
trans = log(mean.a)
trans
summary(trans)
# Histogram
hist(trans, main="Histogram of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan")
# Boxplot
boxplot(trans, main="Boxplot of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan", horizontal=TRUE)
# Q-Q plot
qqnorm(trans, main="Normal Q-Q Plot of bootstrap log(means)")
qqline(trans, col = "red")
# Platonic
# Sampling
B = 10000
mean.b = numeric(B)
for(i in 1:B){ mean.b[i] = mean(sample(platonic_response_latency, size=32, replace=TRUE)) }
# Summary statistics
summary(mean.b)
# Transform
trans2 = log(mean.b)
trans2
summary(trans2)
# Histogram
hist(trans2, main="Histogram of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan")
# Boxplot
boxplot(trans2, main="Boxplot of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan", horizontal=TRUE)
# Q-Q plot
qqnorm(trans2, main="Normal Q-Q Plot of bootstrap log(means)")
qqline(trans2, col = "red")
# Parametric bootstrap hypothesis testing
# H_0: Average target response latency is equal to average platonic response latency
# H_1: Average target response latency is less than average platonic response latency
PB = 10000
mean.hyp = mean(trans2)
boot.mean.H0 = numeric(PB)
# Generating samples
for (i in 1: PB){
para_boot = rnorm(32, mean = mean.hyp, sd = sd(trans)) # Notice this is under H0
boot.mean.H0[i] = mean(para_boot)
}
# p-value
para_boot.pval = (1 + length(boot.mean.H0[boot.mean.H0 <= mean(trans)])) / (PB + 1)
para_boot.pval
###############################################################
# Conclusion
###############################################################
# Comparing both tests, bootstrap is superior.
# Both test's p-values indicate that target's response latency
# is less than platonic response latency with overwhelming evidence.
# Hence concluding that target treats me as:
# more than a friend ^-^!
