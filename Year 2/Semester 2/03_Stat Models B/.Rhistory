# Extra Q4:
# Load data 'PlantGrowth' from library(datasets)
# Then, use QQ plot to investigate whether the data
# weight can be modelled by a normal distribution.
# Load the dataset
library(datasets)
data(PlantGrowth)
?PlantGrowth
weight = PlantGrowth$weight
hist(weight)
qqnorm(weight)
qqline(weight)
