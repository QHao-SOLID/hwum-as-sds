# Lab 2, don't do Q3
# Notes:
# Some common way of transforming data:
# square root transform, reciprocal transform, log transform
# Q1
library(MASS)
data(abbey)
hist(abbey)
qexp(ppoints(31))
plot(qexp(ppoints(31)),sort(abbey))
lqs(sort(abbey)~qexp(ppoints(31))-1)
abline(0,11.84)
# Transformation (inverse transform works! )
qqplot(qnorm(ppoints(31)),1/(sort(abbey)))
qqline(1/(sort(abbey)))
# Conclusion, not normal even after transform.
# Notes:
# square root transform makes stuff smaller, good for right skew
# Log transform makes stuff very small, good for very right skew
# inverse transform in the middle, but be careful of 0 case, remember to remove.
# Q2
animal = c(11, 54, 5, 7, 4, 15, 560, 18, 120, 24, 3, 51, 3, 12, 84)
hist(animal)# Very right skewed.
# Consider transformations:
# square root transform:
hist(sqrt(animal))
# nope
# log transform:
hist(log(animal))
# nope too
# how about inverse transform:
hist(1/(animal))
# even worse
# none of them can be modelled using Gaussian Normal
# Investigate untransformed with exponential dist.
plot(qexp(ppoints(15)),sort(animal))
lqs(sort(animal)~qexp(ppoints(15))-1)
abline(0,21.64)
# No, not reasonably modelled by exponential distribution.
