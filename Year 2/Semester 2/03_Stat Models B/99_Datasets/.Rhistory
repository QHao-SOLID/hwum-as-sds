xlab = "response time (in minutes)", horizontal = T)
boxplot(target_response_latency, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
# Checking for normality
par(mfrow=c(1,1))
qqnorm(platonic_response_latency, pch = 20)
qqline(platonic_response_latency, col="red")
qqnorm(target_response_latency, pch = 20)
qqline(target_response_latency, col = "red")
# Transform data
# Platonic
plat_trans1 = sqrt(platonic_response_latency)
plat_trans1
qqnorm(plat_trans1, pch = 20)
qqline(plat_trans1, col="red")
plat_trans2 = 1/(platonic_response_latency)
plat_trans2
qqnorm(plat_trans2, pch = 20)
qqline(plat_trans2, col="red")
plat_trans3 = log(platonic_response_latency)
plat_trans3
qqnorm(plat_trans3, pch = 20)
qqline(plat_trans3, col="red")
# Target
target_trans1 = sqrt(target_response_latency)
target_trans1
qqnorm(target_trans1, pch = 20)
qqline(target_trans1, col="red")
target_trans2 = 1/(target_response_latency)
target_trans2
qqnorm(target_trans2, pch = 20)
qqline(target_trans2, col="red")
target_trans3 = log(target_response_latency)
target_trans3
qqnorm(target_trans3, pch = 20)
qqline(target_trans3, col="red")
# square-root transform
# Histogram
par(mfrow=c(1,2))
hist(plat_trans1, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Platonic")
hist(target_trans1, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Target")
# Boxplot
par(mfrow=c(2,1))
boxplot(plat_trans1, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
boxplot(target_trans1, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
# inverse transform
# Histogram
par(mfrow=c(1,2))
hist(plat_trans2, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Platonic")
hist(target_trans2, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Target")
# Boxplot
par(mfrow=c(2,1))
boxplot(plat_trans2, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
boxplot(target_trans2, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
# log transform
# Histogram
par(mfrow=c(1,2))
hist(plat_trans3, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Platonic")
hist(target_trans3, col = "cyan",
xlab = "response time (in minutes)",
ylab = "frequency", main = "Target")
# Boxplot
par(mfrow=c(2,1))
boxplot(plat_trans3, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
boxplot(target_trans3, col = "cyan",
xlab = "response time (in minutes)", horizontal = T)
# Seems like log transform fits normal distribution assumption the best
# t-test (using lognormal data)
# H_0: Average target response latency is equal to average platonic response latency
# H_1: Average target response latency is less than average platonic response latency
results = t.test(target_trans3,
plat_trans3,
alternative = "less",
conf.level = 0.95)
results
# Due to lack of samples, attempting bootstrap method
###############################################################
# BootStrap
###############################################################
par(mfrow=c(1,1))
# Target
# Sampling
A = 10000
mean.a = numeric(A)
for(i in 1:A){ mean.a[i] = mean(sample(target_response_latency, size=32, replace=TRUE)) }
# Summary statistics
summary(mean.a)
# Transform
trans = log(mean.a)
trans
summary(trans)
# Histogram
hist(trans, main="Histogram of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan")
# Boxplot
boxplot(trans, main="Boxplot of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan", horizontal=TRUE)
# Q-Q plot
qqnorm(trans, main="Normal Q-Q Plot of bootstrap log(means)")
qqline(trans, col = "red")
# Platonic
# Sampling
B = 10000
mean.b = numeric(B)
for(i in 1:B){ mean.b[i] = mean(sample(platonic_response_latency, size=32, replace=TRUE)) }
# Summary statistics
summary(mean.b)
# Transform
trans2 = log(mean.b)
trans2
summary(trans2)
# Histogram
hist(trans2, main="Histogram of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan")
# Boxplot
boxplot(trans2, main="Boxplot of bootstrap log(means)",
xlab= "Bootstrap log(means)", col="cyan", horizontal=TRUE)
# Q-Q plot
qqnorm(trans2, main="Normal Q-Q Plot of bootstrap log(means)")
qqline(trans2, col = "red")
# Parametric bootstrap hypothesis testing
# H_0: Average target response latency is equal to average platonic response latency
# H_1: Average target response latency is less than average platonic response latency
PB = 10000
mean.hyp = mean(trans2)
boot.mean.H0 = numeric(PB)
# Generating samples
for (i in 1: PB){
para_boot = rnorm(32, mean = mean.hyp, sd = sd(trans)) # Notice this is under H0
boot.mean.H0[i] = mean(para_boot)
}
# p-value
para_boot.pval = (1 + length(boot.mean.H0[boot.mean.H0 <= mean(trans)])) / (PB + 1)
para_boot.pval
###############################################################
# Conclusion
###############################################################
# Comparing both tests, bootstrap is superior.
# Both test's p-values indicate that target's response latency
# is less than platonic response latency with overwhelming evidence.
# Hence concluding that target treats me as:
# more than a friend ^-^!
